<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET Framework 4.8 for maximum Windows compatibility -->
    <TargetFramework>net48</TargetFramework>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OneSignCredentialProvider</AssemblyName>
    <RootNamespace>OneSign.CredentialProvider</RootNamespace>
    <AssemblyTitle>OneSign Windows Credential Provider</AssemblyTitle>
    <AssemblyDescription>Tap-and-go RFID credential provider for Windows logon/unlock</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © OneSign</Copyright>

    <!-- COM-visible DLL -->
    <OutputType>Library</OutputType>
    <RegisterForComInterop>false</RegisterForComInterop>
    <ComVisible>true</ComVisible>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>

    <!-- Deterministic build -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
